# ══════════════════════════════════════════════════════════
# Content Farm Platform — Environment Variables
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# docker-compose automatically reads from .env

# ── Encryption ─────────────────────────────────────────────
# Used to encrypt YouTube OAuth credentials in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── YouTube OAuth ──────────────────────────────────────────
# Get these from Google Cloud Console > APIs & Services > Credentials
# Enable YouTube Data API v3 first.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/v1/youtube/callback

# ── Redis (only change if using external Redis) ────────────
# REDIS_HOST=redis
# REDIS_PORT=6379
